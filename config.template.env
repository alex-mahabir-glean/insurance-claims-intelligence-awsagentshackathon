# AWS Configuration
AWS_REGION=us-east-1
AWS_PROFILE=your-aws-profile-name

# Deployment Configuration
STACK_NAME=legal-service-stack
DEPLOYMENT_ID=legal

# Glean Configuration (Optional - for embedded agents in HTML)
# Leave empty if not using embedded Glean agents
GLEAN_INTAKE_AGENT_ID=
GLEAN_REVIEW_AGENT_ID=

# Local Development Server (Optional)
# Port for serving HTML portals locally (default: 8000)
LOCAL_SERVER_PORT=8000
